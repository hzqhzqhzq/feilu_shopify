{% doc %}
  @prompt
    帮我生成一个可以切换的tab布局, 选中的时候，黑底白字, content要支持{{ product.metafields.custom.inch_size_table.value }}这种写法
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tab-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.container_padding }}px;
    border-radius: {{ block.settings.container_border_radius }}px;
  }

  .ai-tab-list-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_gap }}px;
    border-bottom: {{ block.settings.tab_border_width }}px solid {{ block.settings.tab_border_color }};
    margin-bottom: {{ block.settings.content_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-tab-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: {{ block.settings.tab_padding }}px {{ block.settings.tab_padding | times: 1.5 }}px;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    color: {{ block.settings.tab_text_color }};
    border-bottom: {{ block.settings.tab_border_width }}px solid transparent;
    margin-bottom: -{{ block.settings.tab_border_width }}px;
    transition: all 0.3s ease;
    white-space: nowrap;
    border-radius: {{ block.settings.tab_border_radius }}px {{ block.settings.tab_border_radius }}px 0 0;
  }

  .ai-tab-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_hover_color }};
  }

  .ai-tab-button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg_color }};
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_bg_color }};
  }

  .ai-tab-panel-{{ ai_gen_id }} {
    display: none;
    animation: ai-tab-fade-in-{{ ai_gen_id }} 0.3s ease;
  }

  .ai-tab-panel-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tab-content-{{ ai_gen_id }} {
    color: {{ block.settings.content_text_color }};
    font-size: {{ block.settings.content_font_size }}px;
    line-height: 1.6;
  }

  .ai-tab-content-{{ ai_gen_id }} h3 {
    margin-top: 0;
    margin-bottom: 12px;
  }

  .ai-tab-content-{{ ai_gen_id }} p {
    margin: 0;
  }

  @keyframes ai-tab-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-tab-list-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_gap | times: 0.5 }}px;
    }

    .ai-tab-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
      padding: {{ block.settings.tab_padding | times: 0.8 }}px {{ block.settings.tab_padding | times: 1.2 }}px;
    }
  }
{% endstyle %}

<tab-switcher-{{ ai_gen_id }} class="ai-tab-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tab-list-{{ ai_gen_id }}" role="tablist">
    {% for i in (1..3) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_title_key = 'tab_' | append: i | append: '_title'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_title = block.settings[tab_title_key]
      %}
      
      {% if tab_enabled and tab_title != blank %}
        <button
          class="ai-tab-button-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="ai-tab-panel-{{ ai_gen_id }}-{{ i }}"
          id="ai-tab-{{ ai_gen_id }}-{{ i }}"
          data-tab-index="{{ i }}"
        >
          {{ tab_title }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-tab-panels-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_title_key = 'tab_' | append: i | append: '_title'
        assign tab_content_key = 'tab_' | append: i | append: '_content'
        assign tab_liquid_key = 'tab_' | append: i | append: '_liquid'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_title = block.settings[tab_title_key]
        assign tab_content = block.settings[tab_content_key]
        assign tab_liquid = block.settings[tab_liquid_key]
      %}
      
      {% if tab_enabled and tab_title != blank %}
        <div
          class="ai-tab-panel-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          role="tabpanel"
          aria-labelledby="ai-tab-{{ ai_gen_id }}-{{ i }}"
          id="ai-tab-panel-{{ ai_gen_id }}-{{ i }}"
          tabindex="0"
        >
          <div class="ai-tab-content-{{ ai_gen_id }}">
            {% if tab_liquid != blank %}
              {{ tab_liquid }}
            {% elsif tab_content != blank %}
              {{ tab_content }}
            {% else %}
              <p style="color: #999; font-style: italic;">请为此标签页添加内容</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</tab-switcher-{{ ai_gen_id }}>

<script>
  (function() {
    class TabSwitcher{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-tab-button-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-tab-panel-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            this.switchTab(tab);
          });

          tab.addEventListener('keydown', (e) => {
            this.handleKeyboard(e, tab);
          });
        });
      }

      switchTab(selectedTab) {
        const tabIndex = selectedTab.getAttribute('data-tab-index');

        this.tabs.forEach((tab) => {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        });

        this.panels.forEach((panel) => {
          panel.classList.remove('active');
        });

        selectedTab.classList.add('active');
        selectedTab.setAttribute('aria-selected', 'true');

        const targetPanel = this.querySelector('#ai-tab-panel-{{ ai_gen_id }}-' + tabIndex);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      }

      handleKeyboard(e, currentTab) {
        const tabsArray = Array.from(this.tabs);
        const currentIndex = tabsArray.indexOf(currentTab);

        let targetTab = null;

        if (e.key === 'ArrowRight') {
          e.preventDefault();
          targetTab = tabsArray[currentIndex + 1] || tabsArray[0];
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          targetTab = tabsArray[currentIndex - 1] || tabsArray[tabsArray.length - 1];
        } else if (e.key === 'Home') {
          e.preventDefault();
          targetTab = tabsArray[0];
        } else if (e.key === 'End') {
          e.preventDefault();
          targetTab = tabsArray[tabsArray.length - 1];
        }

        if (targetTab) {
          targetTab.focus();
          this.switchTab(targetTab);
        }
      }
    }

    customElements.define('tab-switcher-{{ ai_gen_id }}', TabSwitcher{{ ai_gen_id }});
  })();
</script>

